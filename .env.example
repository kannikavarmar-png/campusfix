# ==========================================================
# CampusFix AI – Environment Configuration
# Copy this file to `.env` and fill in your credentials.
# Never commit `.env` to version control.
# ==========================================================

# 1. Server Port (default: 3001)
PORT=3001

# 2. Google Gemini API Key (SERVER-SIDE ONLY — never prefix with VITE_)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model override (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# 3. Supabase Configuration (Frontend public keys)
# Find these in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 4. Supabase Server Configuration (SERVER-SIDE ONLY — never expose to client)
# Used by the Express backend for public aggregate stats & verified lookups
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
